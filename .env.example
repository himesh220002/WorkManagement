# ==============================================================================
# TaskFlow Enterprise Work Management - Environment Variables Configuration
# ==============================================================================
# Duplicate this file as `.env` in the project root and fill in the values below:
#   cp env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & MULTI-TENANT PERSISTENCE (REQUIRED)
# ------------------------------------------------------------------------------
# MongoDB connection URI. Supports MongoDB Atlas cluster or local MongoDB instance.
# Multi-tenant organization databases (e.g. projectManageDB_ORGTTV) will be derived
# automatically from this base connection string.
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/projectManageDB?retryWrites=true&w=majority
# Local dev: mongodb://localhost:27017/projectManageDB
MONGODB_URI=mongodb://localhost:27017/projectManageDB

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY TOKENS (REQUIRED)
# ------------------------------------------------------------------------------
# High-entropy secret string used to sign and verify session JWT cookies.
# Generate a secure key with: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-replace-me-in-production

# JWT session token expiration window (e.g., 7d, 24h, 30d). Default is 7d.
JWT_EXPIRES_IN=7d

# Emergency developer/executive master key for rapid testing and login bypass.
# Allows instant login using the master passkey in the login screen.
MASTER_DEV_KEY=TaskFlowMasterKey2026!Unlock

# ------------------------------------------------------------------------------
# 3. AWS S3 CLOUD STORAGE (DOCUMENT ATTACHMENTS & ASSETS)
# ------------------------------------------------------------------------------
# AWS S3 credentials used for file uploads, project specs, and PDF transcripts.
# If omitted or invalid, local fallback memory storage will be utilized where available.
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=taskflow-pm-storage-prod
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Optional: AWS KMS Key ID if S3 server-side encryption with customer key is enabled
# AWS_KMS_KEY_ID=arn:aws:kms:region:account-id:key/your-key-id

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY & SUBSCRIPTION PAYWALL
# ------------------------------------------------------------------------------
# Razorpay API Credentials (https://dashboard.razorpay.com/app/keys)
#
# NOTE ON SANDBOX / SIMULATION MODE:
# If left empty or omitted, TaskFlow automatically runs in a safe automated sandbox
# simulation mode. Checkout modals will simulate payments and test subscriptions
# without requiring live Razorpay merchant credentials!
#
# Server-side Key ID (Test key: rzp_test_... / Live key: rzp_live_...)
RAZORPAY_KEY_ID=

# Server-side Secret Key (Used for HMAC SHA256 payment signature verification)
RAZORPAY_KEY_SECRET=

# Client-side exposed Key ID for opening the Razorpay Checkout checkout modal:
# (Should match RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------------------
# 5. DISCORD WEBHOOK ALERTS (CONTACT INQUIRIES)
# ------------------------------------------------------------------------------
# Your Discord channel incoming webhook URL (Server Settings -> Integrations -> Webhooks).
# When visitors submit inquiries on the /contact page, an instant rich notification
# is dispatched directly to your private Discord channel.
# Example: https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz...
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK=

# ------------------------------------------------------------------------------
# 6. AUTOMATED CRON & AWS EVENTBRIDGE SCHEDULERS (OPTIONAL)
# ------------------------------------------------------------------------------
# Bearer secret token used to authenticate automated periodic snapshot and meeting crons.
# Can be called by AWS EventBridge, AWS Lambda, or Vercel Cron:
#   1. Health Snapshots: GET/POST /api/cron/snapshot
#   2. Meeting Expirations & Recurring Rollovers: GET/POST /api/cron/meetings
# Example: curl -X POST -H "Authorization: Bearer <CRON_SECRET>" https://taskpms.cyphertech.online/api/cron/meetings
CRON_SECRET=default_snapshot_secret_key_2026

# ------------------------------------------------------------------------------
# 7. ANALYTICS & FRONTEND TELEMETRY (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID for pageview and event telemetry
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY CONNECTIVITY & WEBHOOKS REFERENCE
# ------------------------------------------------------------------------------
# The Meetings & Discussions Hub and CRM integrations support dynamic per-session
# links directly inside the application:
#
# - Google Meet:
#     Click "Create Google Meet Room ↗" (https://meet.google.com/new) to create a real room,
#     then click Paste into the meeting schedule field.
# - Zoom:
#     Click "Schedule on Zoom ↗" (https://zoom.us/meeting/schedule) to copy permanent meeting ID.
# - Discord:
#     Enter channel name (e.g. #voice-scrim-lab) and invite URL (https://discord.gg/...).
# - Slack:
#     Enter channel name (e.g. #growth-daily) and Incoming Webhooks (https://hooks.slack.com/services/...).
# ==============================================================================

